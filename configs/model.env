# Shared by the local LLM and agent launch scripts.
# Edit these defaults to switch models. Existing environment overrides still work.
model_path="${QWEN_MODEL_PATH:-/storage/models/Qwen3.6-27B/}"
model_name="${VLLM_MODEL_NAME:-qwen3.6-27b}"

# Local GPU selection and inference limits. GPU IDs are those shown by nvidia-smi.
VLLM_GPU="${VLLM_GPU:-0}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-262144}"
VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.8}"
