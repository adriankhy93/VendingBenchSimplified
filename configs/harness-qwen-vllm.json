{
  "agent": "model",
  "provider": "vllm",
  "model": "qwen3.5-2b",
  "token_budget": 500000,
  "max_output_tokens": 512,
  "recent_pairs": 6,
  "vllm": {
    "base_url": "http://127.0.0.1:8001/v1",
    "enable_thinking": false,
    "tool_choice": "required"
  },
  "instruction_paths": [
    "prompts/qwen-vllm.md"
  ],
  "enable_memory": true
}
